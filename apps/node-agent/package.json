{
  "name": "@strict-proxy/node-agent",
  "version": "0.1.0",
  "version_note": "kept in lockstep with controller",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/agent.ts",
    "start": "node --import tsx src/agent.ts",
