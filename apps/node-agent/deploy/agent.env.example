# =============================================================================
# agent.env.example — TEMPLATE FOR A SYSTEMD-INSTALLED NODE
#
# Copy to /etc/strict-proxy/agent.env on the exit VPS (install-node.sh does
# this), then fill in CONTROLLER_URL, NODE_ENROLLMENT_TOKEN and
# NODE_HOSTNAME. Mode 0600: it holds a one-time enrollment token until the
# agent has enrolled.
#
# READ BY: the node agent installed by apps/node-agent/deploy/install-node.sh
# and started by strict-proxy-agent.service.
#
# NOT USED BY DOCKER. A containerised node (docker-compose.dokploy-node.yml, or
# the `node` profile of docker-compose.production.yml) receives the same
# settings through the Compose `environment:` block instead; do not create this
# file in those deployments.
#
# After the first successful enrollment the token is spent: delete the
# NODE_ENROLLMENT_TOKEN line and restart the agent. The permanent identity
# (node id, HMAC secret, REALITY keypair) is saved in NODE_IDENTITY_PATH.
#
# STEP BY STEP: SETUP.md section 7.  FILE MAP: docs/FILE-MAP.md
# ============================================================================
# First boot requires CONTROLLER_URL and NODE_ENROLLMENT_TOKEN.
# After enrollment the agent persists NODE_ID/NODE_HMAC_SECRET in NODE_IDENTITY_PATH.
CONTROLLER_URL=https://controller.example.com
NODE_ENROLLMENT_TOKEN=paste-one-time-token-from-admin
NODE_IDENTITY_PATH=/etc/strict-proxy/node-identity.json
# Optional: pin the advertised address. Leave empty to auto-detect it.
NODE_PUBLIC_IP=
# Where to read this node's own public IP from. Set to `off` to disable.
NODE_PUBLIC_IP_ECHO_URL=https://api.ipify.org
NODE_PUBLIC_IP_DETECT_INTERVAL_SECONDS=600
NODE_TUNNEL_PORT=443
NODE_HOSTNAME=node-a.example.com
NODE_LABEL=Frankfurt 1
NODE_REALITY_SERVER_NAME=www.microsoft.com
SING_BOX_BINARY=/usr/local/bin/sing-box
# systemd for a host-installed service; managed for Docker.
SING_BOX_RESTART_MODE=systemd
SING_BOX_CONFIG_PATH=/etc/sing-box/config.json
SING_BOX_STATS_API_LISTEN=127.0.0.1:10085
SING_BOX_STATS_PROTO=/opt/strict-proxy/node-agent/src/v2rayapi/stats.proto
HEARTBEAT_INTERVAL_SECONDS=30
SYNC_INTERVAL_SECONDS=60
USAGE_INTERVAL_SECONDS=60
LOG_LEVEL=info
