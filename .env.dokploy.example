# =============================================================================
# .env.dokploy.example — TEMPLATE FOR THE DOKPLOY DEPLOYMENT
#
# This file is a worksheet, not a runtime file: no running service reads it from
# disk. Two blocks follow:
#   - the CONTROLLER block -> paste into the Environment tab of the Dokploy
#     Compose service using docker-compose.dokploy.yml
#   - the NODE block       -> paste into the Environment tab of each exit VPS's
#     service using docker-compose.dokploy-node.yml
#
# Dokploy substitutes ${NAME} exactly like Compose does, so this KEY=VALUE
# format and these comments are valid there. Inside a container, localhost is
# the container itself: the controller URLs must use the service names
# `postgres` and `redis`.
#
# Keep the filled-in values in a password manager, never in git.
#
# FILE MAP: docs/FILE-MAP.md   WALKTHROUGH: docs/DOKPLOY.md
# =============================================================================
# Environment for the Dokploy deployment. Copy this into the Dokploy service's
# Environment tab — never commit a filled-in copy. Replace every `replace-*`
# value before deploying; the controller refuses to boot on missing secrets.
#
# Generate values with:
#   openssl rand -hex 32            # passwords/secrets (URL-safe hex)
#   openssl rand -base64 48         # JWT_SECRET / PAYMENT_WEBHOOK_SECRET
#   openssl genpkey -algorithm ed25519 -out signing-key.pem
#   awk 'BEGIN{ORS="\\n"} {print}' signing-key.pem   # ready for SIGNING_PRIVATE_KEY_PEM
#   openssl pkey -in signing-key.pem -pubout -outform DER | tail -c 32 | base64
#     -> STRICT_SIGNING_PUBLIC_KEY for the client build (public, not secret)
#
# Back up signing-key.pem. Changing the signing key invalidates every installed
# client: they verify bundles against the public half baked into the app.

# ---------------------------------------------------------------------------
# Controller stack — docker-compose.dokploy.yml
# ---------------------------------------------------------------------------
NODE_ENV=production

# The public HTTPS URL users and the admin dashboard reach. A localhost value
# is refused at boot in production. Set this to the domain assigned to the
# `controller` service in Dokploy.
PUBLIC_APP_URL=https://api.example.com

# Port the controller listens on inside the container and the port Traefik
# proxies to. It is NOT published on the host. Leave 8080 unless something else
# needs it; if you change it, set the same number as the domain's "Internal
# port" in Dokploy -> Domains. A mismatch there gives 502, not 404.
CONTROLLER_INTERNAL_PORT=8080

POSTGRES_USER=strict
POSTGRES_PASSWORD=replace-with-hex-32
POSTGRES_DB=strict_proxy
# Must use the compose service name `postgres`, not localhost.
CONTROLLER_DATABASE_URL=postgres://strict:replace-with-hex-32@postgres:5432/strict_proxy

REDIS_PASSWORD=replace-with-hex-32
# Must use the compose service name `redis`, not localhost.
CONTROLLER_REDIS_URL=redis://:replace-with-hex-32@redis:6379

JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_ISSUER=strict-proxy-controller
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# PKCS#8 Ed25519 private key, with real newlines escaped as the two characters
# \n. The matching public key is compiled into the client.
SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace-with-real-key\n-----END PRIVATE KEY-----\n"
SIGNING_KEY_ID=primary

PAYMENT_WEBHOOK_SECRET=replace-with-openssl-rand-base64-48
# Encrypts the SMTP password at rest. Rotating it requires re-entering SMTP.
SETTINGS_ENCRYPTION_KEY=replace-with-hex-32

# Origins allowed to call the API from a browser. The mobile client and the
# same-origin dashboard need none, so leave empty unless you add a web client.
# `*` is refused at boot in production.
CORS_ORIGINS=
# Dokploy puts exactly one proxy (Traefik) in front of the controller.
TRUST_PROXY_HOPS=1
NODE_IP_AUTODETECT=true
ENABLE_HSTS=true

HEARTBEAT_TTL_SECONDS=90
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300
DEFAULT_REALITY_SERVER_NAME=www.microsoft.com
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# Payments are optional. Set BOTH the key and the webhook secret, or neither;
# half-configured is refused at boot. Webhook URL:
#   https://api.example.com/webhooks/payments
OPENPAY_API_KEY=
OPENPAY_BASE_URL=https://api.openpay.fiatden.com
OPENPAY_WEBHOOK_SECRET=
OPENPAY_SIGNATURE_HEADER=x-webhook-signature-v1
OPENPAY_TIMESTAMP_TOLERANCE_SECONDS=300
OPENPAY_PLATFORM_NAME=StrictProxy

# Amounts are minor units (kobo with NGN): 250000 = ₦2,500.00.
BILLING_CURRENCY=NGN
STANDARD_TIER_AMOUNT_MINOR=250000
PRO_TIER_AMOUNT_MINOR=750000

# ---------------------------------------------------------------------------
# Exit-node stack — docker-compose.dokploy-node.yml
# Deployed separately on each exit VPS, with its own environment.
# ---------------------------------------------------------------------------
NODE_CONTROLLER_URL=https://api.example.com
# One-time, region-scoped token from Admin -> Enrollments. Remove after the
# node has enrolled and its identity is saved in the nodeidentity volume.
NODE_ENROLLMENT_TOKEN=
NODE_HOSTNAME=node1.example.com
NODE_LABEL=Frankfurt 1
NODE_TUNNEL_PORT=443
# Leave empty to detect the VPS's public IP automatically.
NODE_PUBLIC_IP=
