# Docker network settings. Choose a non-overlapping RFC1918 range for each host.
BACKEND_NETWORK_DRIVER=bridge
BACKEND_NETWORK_IPAM_DRIVER=default
BACKEND_NETWORK_SUBNET=172.30.0.0/16
BACKEND_NETWORK_GATEWAY=172.30.0.1

# Docker deployment secrets. Copy to .env.docker and replace every value.
COMPOSE_PROJECT_NAME=strict-proxy
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_USER=strict
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=strict_proxy
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

REDIS_IMAGE=redis:7-alpine
REDIS_PASSWORD=replace-with-a-long-random-redis-password
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_APPENDONLY=yes

# Internal service URLs must use Docker service names, not localhost.
CONTROLLER_DATABASE_URL=postgres://strict:replace-with-a-long-random-password@postgres:5432/strict_proxy
CONTROLLER_REDIS_URL=redis://:replace-with-a-long-random-redis-password@redis:6379

JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_ISSUER=strict-proxy-controller
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\\nreplace-with-ed25519-private-key\\n-----END PRIVATE KEY-----\\n"
SIGNING_KEY_ID=primary
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Controller edge settings.
CONTROLLER_BIND_ADDRESS=127.0.0.1
CONTROLLER_PORT=8080
CONTROLLER_HOSTNAME=strict-proxy-controller
CONTROLLER_INTERNAL_PORT=8080
CORS_ORIGINS=https://app.example.com
TRUST_PROXY_HOPS=1
ENABLE_HSTS=false
HSTS_MAX_AGE_SECONDS=31536000
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60
OPENPAY_API_KEY=
OPENPAY_BASE_URL=https://api.openpay.example.com
OPENPAY_WEBHOOK_SECRET=
OPENPAY_SIGNATURE_HEADER=x-webhook-signature-v1
OPENPAY_TIMESTAMP_TOLERANCE_SECONDS=300
OPENPAY_PLATFORM_NAME=StrictProxy
BILLING_CURRENCY=NGN
STANDARD_TIER_AMOUNT_MINOR=250000
PRO_TIER_AMOUNT_MINOR=750000

# Optional Caddy edge. Keep TLS_MODE=disabled for local HTTP testing.
TLS_MODE=disabled
TLS_EMAIL=ops@example.com
CADDY_SITE_ADDRESS=http://localhost
CADDY_CONTROLLER_HOST=controller
EDGE_BIND_ADDRESS=0.0.0.0
EDGE_HTTP_PORT=80
EDGE_HTTPS_PORT=443
EDGE_IMAGE=caddy:2.11.4-alpine

# Resource, restart, persistence, and logging policy.
POSTGRES_DATA_VOLUME=strict-proxy-pgdata
REDIS_DATA_VOLUME=strict-proxy-redisdata
EDGE_CONFIG_VOLUME=strict-proxy-caddyconfig
EDGE_DATA_VOLUME=strict-proxy-caddydata
EDGE_STATE_VOLUME=strict-proxy-caddystate
POSTGRES_MEMORY_LIMIT=1g
REDIS_MEMORY_LIMIT=256m
CONTROLLER_MEMORY_LIMIT=512m
CONTROLLER_CPU_LIMIT=1
NODE_AGENT_MEMORY_LIMIT=512m
NODE_AGENT_CPU_LIMIT=2
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5
DOCKER_LOG_DRIVER=json-file

# Used only with --profile node on a VPS.
SING_BOX_VERSION=1.13.21
NODE_CONTROLLER_URL=http://127.0.0.1:8080
NODE_ENROLLMENT_TOKEN=
NODE_PUBLIC_IP=203.0.113.10
NODE_TUNNEL_PORT=443
NODE_HOSTNAME=node.example.com
NODE_LABEL=Primary node
NODE_IDENTITY_VOLUME=strict-proxy-nodeidentity
NODE_TUN_DEVICE=/dev/net/tun
NODE_NETWORK_MODE=host
NODE_NET_ADMIN_CAPABILITY=NET_ADMIN

# Set TLS_MODE=managed and CADDY_SITE_ADDRESS=https://api.example.com only when
# DNS points to this host and inbound TCP ports 80/443 are reachable.
