# Central Controller (apps/controller)
PORT=8080
DATABASE_URL=postgres://strict:strict@localhost:5432/strict_proxy
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-openssl-rand-base64-48
JWT_ISSUER=strict-proxy-controller
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Ed25519 signing (escape newlines as \n when storing the PEM here)
SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SIGNING_KEY_ID=primary

# Payment gateway (placeholder adapter verifies HMAC over the raw body)
PAYMENT_WEBHOOK_SECRET=change-me

# Fleet
HEARTBEAT_TTL_SECONDS=90
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300
DEFAULT_REALITY_SERVER_NAME=www.microsoft.com
CORS_ORIGINS=*

# Seed script
SEED_ADMIN_EMAIL=admin@strict.local
SEED_ADMIN_PASSWORD=change-me
