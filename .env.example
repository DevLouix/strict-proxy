# Central Controller (apps/controller)
PORT=8080
DATABASE_URL=postgres://strict:strict@localhost:5432/strict_proxy
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-openssl-rand-base64-48
JWT_ISSUER=strict-proxy-controller
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Ed25519 signing (escape newlines as \n when storing the PEM here)
SIGNING_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SIGNING_KEY_ID=primary

# Payment gateway (placeholder adapter verifies HMAC over the raw body)
PAYMENT_WEBHOOK_SECRET=change-me

# Fleet
HEARTBEAT_TTL_SECONDS=90
HMAC_TIMESTAMP_TOLERANCE_SECONDS=300
DEFAULT_REALITY_SERVER_NAME=www.microsoft.com
CORS_ORIGINS=*

# Abuse controls on the unauthenticated auth + webhook surfaces (per IP).
RATE_LIMIT_MAX_ATTEMPTS=10
RATE_LIMIT_WINDOW_SECONDS=60

# OpenPay gateway. Leave OPENPAY_API_KEY empty to run without a live gateway;
# /webhooks/payments then expects the placeholder HMAC adapter instead.
OPENPAY_API_KEY=
OPENPAY_BASE_URL=https://api.openpay.example.com
OPENPAY_WEBHOOK_SECRET=
OPENPAY_SIGNATURE_HEADER=x-openpay-signature
OPENPAY_TIMESTAMP_TOLERANCE_SECONDS=300
OPENPAY_PLATFORM_NAME=StrictProxy

# Billing catalog (amounts are in the currency's minor unit, e.g. kobo)
BILLING_CURRENCY=NGN
STANDARD_TIER_AMOUNT_MINOR=250000
PRO_TIER_AMOUNT_MINOR=750000

# Seed script
SEED_ADMIN_EMAIL=admin@strict.local
SEED_ADMIN_PASSWORD=change-me
