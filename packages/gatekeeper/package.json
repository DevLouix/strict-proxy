{
  "name": "@strict-proxy/gatekeeper",
  "version": "0.1.0",
  "description": "Official StrictProxy Gatekeeper SDK — protect websites and APIs so only users routed through your StrictProxy fleet (and optional plan tier) can access them.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "strict-proxy",
    "gatekeeper",
    "proxy-auth",
    "vpn",
    "ed25519",
    "access-control",
    "middleware",
    "express",
    "nextjs",
    "fastify"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/DevLouix/strict-proxy.git",
    "directory": "packages/gatekeeper"
  },
  "homepage": "https://github.com/DevLouix/strict-proxy/tree/main/packages/gatekeeper#readme",
  "bugs": {
    "url": "https://github.com/DevLouix/strict-proxy/issues"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
